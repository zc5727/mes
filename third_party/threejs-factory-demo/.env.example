VITE_API_BASE_URL=http://localhost:3000/api/v1
# Optional explicit NestJS facade URL; OpenMES remains behind the facade.
# VITE_MES_FACADE_URL=http://localhost:3000/api/v1
VITE_TENANT_ID=tenant-demo
VITE_API_KEY=replace-with-the-backend-MES_API_KEY
# Required for direct local write/control calls. In production these identity
# values must come from the trusted gateway, not a browser-controlled default.
# VITE_USER_ROLE=supervisor
# VITE_USER_ID=operator-001
# VITE_FACTORY_ID=factory-demo
# VITE_SCOPE=*
# VITE_SESSION_ID=digital-twin-local
# api is the default; local explicitly enables the deterministic demo simulator.
VITE_DATA_MODE=api
# Optional: ws://localhost:3000/realtime
# VITE_REALTIME_URL=
# Set to sse for the backend digital-twin stream; websocket remains supported for existing gateways.
# VITE_REALTIME_PROTOCOL=sse
# Only use with backend MES_REALTIME_ALLOW_QUERY_KEY=true in local/demo deployments.
# VITE_REALTIME_API_KEY=
