NODE_ENV=development
# Server-owned operation mode: read-only | test-control | approved-control.
# approved-control is reserved for the future approval-backed device-control path.
MES_CONTROL_MODE=test-control
# Simulator fault/control API is for test environments; production is fail-closed unless explicitly overridden.
MES_SIMULATOR_CONTROL_ENABLED=false
PORT=3000
# Only the legacy in-process core is wired today; migration modes fail closed.
MES_CORE=legacy
# Replace with a secret; the literal example value is rejected by the API guard.
MES_API_KEY=replace-with-a-long-random-api-key
MES_ALLOWED_TENANTS=tenant-demo
# Optional trusted identity mode. HS256 JWTs are verified before role/scope checks;
# keep unset for API-key-only local demo mode. Never use a demo secret in production.
# MES_JWT_SECRET=replace-with-a-long-random-jwt-secret
# MES_JWT_ISSUER=mes-identity-provider
# MES_JWT_AUDIENCE=mes-api
MES_REQUIRE_SESSION=false
MES_RATE_LIMIT_PER_MINUTE=120
MES_AGENT_REQUIRE_SERVICE_ACCOUNT=false
MES_AGENT_ALLOWED_ROLES=auditor
MES_SENSITIVE_FIELDS=password,token,secret,apiKey,authorization
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Optional ERPNext bridge. Leave disabled to keep the MES fully standalone.
ERPNEXT_ENABLED=false
# ERPNEXT_URL=http://localhost:8000
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_TIMEOUT_MS=5000
# JSON map of MES tenant IDs to ERPNext company names; unmapped tenants fail closed.
# ERPNEXT_TENANT_MAPPING={"tenant-demo":"Demo Manufacturing"}
DATABASE_URL=postgresql://mes:mes_dev@localhost:5432/mes
# Enable durable MQTT state projections after PostgreSQL is migrated.
DATABASE_ENABLED=false
# Set true in production to fail startup instead of falling back when DB is required.
DATABASE_REQUIRED=false
# Set true with DATABASE_REQUIRED=true for fail-closed audit/approval writes.
MES_AUDIT_PERSISTENCE_REQUIRED=false
# Keep disabled for HTTP-only development; set true when Mosquitto is available.
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_TELEMETRY_TOPIC=mes/simulator/+/lines/+/devices/+/telemetry
MQTT_ALARMS_TOPIC=mes/simulator/+/alarms
# EventSource cannot send Authorization headers; enable query-key auth only for the local SSE demo.
MES_REALTIME_ALLOW_QUERY_KEY=false
MES_TENANT_ID=tenant-demo
# MQTT_GATEWAY_ID=edge-gateway-01
# Optional overrides; defaults subscribe to the simulator telemetry and alarm topics.
# MQTT_CLIENT_ID=mes-ingestion-dev
# MQTT_RECONNECT_PERIOD_MS=1000
# MQTT_TELEMETRY_TOPIC=mes/simulator/+/lines/+/devices/+/telemetry
# MQTT_ALARMS_TOPIC=mes/simulator/+/alarms
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=mes_dev
MINIO_SECRET_KEY=mes_dev_secret
MES_OBJECT_STORAGE=local
MES_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
MES_OBJECT_STORAGE_BUCKET=mes-documents
MES_OBJECT_STORAGE_ACCESS_KEY=mes_dev
MES_OBJECT_STORAGE_SECRET_KEY=mes_dev_secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_MAX_ATTEMPTS=3
S3_LIFECYCLE_DAYS=0
