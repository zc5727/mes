NODE_ENV=development
PORT=3000
MES_API_KEY=replace-with-a-long-random-api-key
MES_ALLOWED_TENANTS=tenant-demo
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional ERPNext bridge. Leave disabled to keep the MES fully standalone.
ERPNEXT_ENABLED=false
# ERPNEXT_URL=http://localhost:8000
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_TIMEOUT_MS=5000
DATABASE_URL=postgresql://mes:mes_dev@localhost:5432/mes
# Enable durable MQTT state projections after PostgreSQL is migrated.
DATABASE_ENABLED=false
# Set true in production to fail startup instead of falling back when DB is required.
DATABASE_REQUIRED=false
# Keep disabled for HTTP-only development; set true when Mosquitto is available.
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MES_TENANT_ID=tenant-demo
# MQTT_GATEWAY_ID=edge-gateway-01
# Optional overrides; defaults subscribe to the simulator telemetry and alarm topics.
# MQTT_CLIENT_ID=mes-ingestion-dev
# MQTT_RECONNECT_PERIOD_MS=1000
# MQTT_TELEMETRY_TOPIC=mes/simulator/+/lines/+/devices/+/telemetry
# MQTT_ALARMS_TOPIC=mes/simulator/+/alarms
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=mes_dev
MINIO_SECRET_KEY=mes_dev_secret
