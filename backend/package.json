{
  "name": "mes-saas-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MES SaaS backend for manufacturing operations, devices and active production control",
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:init": "prisma migrate deploy --schema prisma/schema.prisma && ts-node prisma/seed.ts",
    "db:verify-runtime": "node scripts/verify-db-runtime.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "npm test -- --runInBand && npm run test:e2e -- --runInBand",
    "verify:env": "node scripts/verify-env.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:postgres": "node scripts/verify-postgres.mjs",
    "verify:mock": "node scripts/verify-mock-flow.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:mqtt": "node test/smoke-mqtt.mjs",
    "smoke:fault": "node test/fault-drill.mjs",
    "smoke:digital-twin": "node test/digital-twin-e2e.mjs",
    "smoke:strategy-runtime": "node scripts/smoke-strategy-governance-runtime.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mqtt": "^5.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
