generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkOrderStatus {
  draft
  released
  in_progress
  paused
  completed
  cancelled
}

enum WorkOrderPriority {
  low
  normal
  high
  urgent
}

enum ProductionOrderStatus {
  planned
  in_progress
  completed
  cancelled
}

enum DeviceStatus {
  online
  offline
  maintenance
  alarm
}

enum AlarmLevel {
  info
  warning
  critical
}

enum AlarmStatus {
  open
  acknowledged
  resolved
}

model Tenant {
  id        String   @id @db.VarChar(40)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  factories        Factory[]
  productionLines  ProductionLine[]
  devices          Device[]
  orders           ProductionOrder[]
  workOrders       WorkOrder[]
  reports          WorkOrderReport[]
  alarms           Alarm[]
  strategyRuns     StrategyRun[]
  qualityRecords   QualityRecord[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  documents        DocumentRecord[]
  batchInventories BatchInventory[]

  @@map("tenants")
}

model Factory {
  id        String   @id @db.VarChar(40)
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines  ProductionLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("factories")
}

model ProductionLine {
  id        String   @id @db.VarChar(40)
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  factoryId String   @map("factory_id") @db.VarChar(40)
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  type      String   @db.VarChar(60)
  active    Boolean  @default(true)
  targetOee Decimal? @map("target_oee") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  factory    Factory @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  devices    Device[]
  workOrders WorkOrder[]
  alarms     Alarm[]

  @@unique([tenantId, code])
  @@index([tenantId, factoryId])
  @@map("production_lines")
}

model Device {
  id           String       @id @db.VarChar(40)
  tenantId     String       @map("tenant_id") @db.VarChar(40)
  lineId       String       @map("line_id") @db.VarChar(40)
  code         String       @db.VarChar(80)
  name         String       @db.VarChar(120)
  model        String?      @db.VarChar(80)
  protocol     String?      @db.VarChar(40)
  status       DeviceStatus  @default(offline)
  statusReason String?      @map("status_reason") @db.VarChar(200)
  lastSeenAt   DateTime?    @map("last_seen_at")
  metrics      Json?
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line    ProductionLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  reports WorkOrderReport[]
  alarms  Alarm[]

  @@unique([tenantId, code])
  @@index([tenantId, lineId, status])
  @@map("devices")
}

model ProductionOrder {
  id           String                 @id @db.VarChar(40)
  tenantId     String                 @map("tenant_id") @db.VarChar(40)
  orderNo      String                 @map("order_no") @db.VarChar(80)
  productCode  String                 @map("product_code") @db.VarChar(80)
  productName  String                 @map("product_name") @db.VarChar(120)
  plannedQty   Int                    @map("planned_qty")
  completedQty Int                    @default(0) @map("completed_qty")
  dueAt        DateTime               @map("due_at")
  priority     WorkOrderPriority
  status       ProductionOrderStatus  @default(planned)
  externalId   String?                @map("external_id") @db.VarChar(80)
  externalSystem String?              @map("external_system") @db.VarChar(40)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workOrders WorkOrder[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status, dueAt])
  @@map("production_orders")
}

model WorkOrder {
  id           String          @id @db.VarChar(40)
  tenantId     String          @map("tenant_id") @db.VarChar(40)
  orderId      String?         @map("order_id") @db.VarChar(40)
  orderNo      String          @map("order_no") @db.VarChar(80)
  productCode  String          @map("product_code") @db.VarChar(80)
  productName  String          @map("product_name") @db.VarChar(120)
  lineId       String          @map("line_id") @db.VarChar(40)
  plannedQty   Int             @map("planned_qty")
  completedQty Int             @default(0) @map("completed_qty")
  dueAt        DateTime        @map("due_at")
  priority     WorkOrderPriority @default(normal)
  status       WorkOrderStatus  @default(draft)
  statusReason String          @default("") @map("status_reason") @db.VarChar(200)
  externalId   String?         @map("external_id") @db.VarChar(80)
  externalSystem String?       @map("external_system") @db.VarChar(40)
  bomId        String?         @map("bom_id") @db.VarChar(40)
  routingId    String?         @map("routing_id") @db.VarChar(40)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order         ProductionOrder?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  line          ProductionLine         @relation(fields: [lineId], references: [id], onDelete: Restrict)
  reports       WorkOrderReport[]
  statusHistory WorkOrderStatusHistory[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, lineId, status])
  @@map("work_orders")
}

model WorkOrderReport {
  id            String   @id @db.VarChar(40)
  tenantId      String   @map("tenant_id") @db.VarChar(40)
  workOrderId   String   @map("work_order_id") @db.VarChar(40)
  deviceId      String?  @map("device_id") @db.VarChar(40)
  quantity      Int
  goodQty       Int      @map("good_qty")
  defectQty     Int      @map("defect_qty")
  sourceTraceId String   @map("source_trace_id") @db.VarChar(100)
  batchNo       String?  @map("batch_no") @db.VarChar(80)
  serialNumbers Json?    @map("serial_numbers")
  operationCode String?  @map("operation_code") @db.VarChar(40)
  operatorId    String?  @map("operator_id") @db.VarChar(40)
  qualityRecordId String? @map("quality_record_id") @db.VarChar(40)
  materialConsumptions Json? @map("material_consumptions")
  reportedAt   DateTime @map("reported_at")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sourceTraceId])
  @@index([tenantId, workOrderId, reportedAt])
  @@index([tenantId, deviceId, reportedAt])
  @@map("work_order_reports")
}

model WorkOrderStatusHistory {
  id         String          @id @db.VarChar(40)
  tenantId   String          @map("tenant_id") @db.VarChar(40)
  workOrderId String         @map("work_order_id") @db.VarChar(40)
  fromStatus WorkOrderStatus? @map("from_status")
  toStatus   WorkOrderStatus  @map("to_status")
  reason     String          @default("") @db.VarChar(200)
  operatorId String?         @map("operator_id") @db.VarChar(40)
  occurredAt DateTime        @default(now()) @map("occurred_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId, workOrderId, occurredAt])
  @@map("work_order_status_history")
}

model Alarm {
  id         String      @id @db.VarChar(40)
  tenantId   String      @map("tenant_id") @db.VarChar(40)
  lineId     String?     @map("line_id") @db.VarChar(40)
  deviceId   String?     @map("device_id") @db.VarChar(40)
  code       String      @db.VarChar(80)
  level      AlarmLevel
  status     AlarmStatus @default(open)
  message    String      @db.VarChar(500)
  dedupeKey  String?     @map("dedupe_key") @db.VarChar(160)
  occurredAt DateTime    @map("occurred_at")
  resolvedAt DateTime?   @map("resolved_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  line   ProductionLine? @relation(fields: [lineId], references: [id], onDelete: Restrict)
  device Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, level, occurredAt])
  @@index([tenantId, lineId, occurredAt])
  @@map("alarms")
}

model MqttDeviceState {
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  lineId    String   @map("line_id") @db.VarChar(80)
  deviceId  String   @map("device_id") @db.VarChar(80)
  eventTime DateTime @map("event_time")
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, lineId, deviceId])
  @@index([tenantId, eventTime])
  @@map("mqtt_device_states")
}

model MqttAlarmState {
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  alarmId   String   @map("alarm_id") @db.VarChar(160)
  eventTime DateTime @map("event_time")
  active    Boolean
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, alarmId])
  @@index([tenantId, active, eventTime])
  @@map("mqtt_alarm_states")
}

model QualityRecord {
  id          String   @id @db.VarChar(40)
  tenantId    String   @map("tenant_id") @db.VarChar(40)
  formKey     String   @map("form_key") @db.VarChar(80)
  formVersion String   @map("form_version") @db.VarChar(40)
  status      String   @db.VarChar(30)
  workOrderId String?  @map("work_order_id") @db.VarChar(40)
  batchNo     String   @map("batch_no") @db.VarChar(80)
  lineId      String   @map("line_id") @db.VarChar(40)
  deviceId    String?  @map("device_id") @db.VarChar(40)
  operatorId  String   @map("operator_id") @db.VarChar(80)
  values      Json
  traceId     String   @map("trace_id") @db.VarChar(120)
  trace       Json
  inspectionType String  @default("IPQC") @map("inspection_type") @db.VarChar(10)
  ruleKey     String? @map("rule_key") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, traceId])
  @@index([tenantId, status, updatedAt])
  @@map("quality_records")
}

model MaintenanceWorkOrder {
  id          String   @id @db.VarChar(40)
  tenantId    String   @map("tenant_id") @db.VarChar(40)
  lineId      String   @map("line_id") @db.VarChar(40)
  deviceId    String   @map("device_id") @db.VarChar(40)
  alarmId     String?  @map("alarm_id") @db.VarChar(80)
  inspectionRequired Boolean @default(false) @map("inspection_required")
  inspectionStatus String @default("pending") @map("inspection_status") @db.VarChar(20)
  type        String   @db.VarChar(30)
  title       String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  status      String   @db.VarChar(30)
  plannedAt   DateTime @map("planned_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, status, plannedAt])
  @@map("maintenance_work_orders")
}

model DocumentRecord {
  id                    String   @id @db.VarChar(40)
  tenantId              String   @map("tenant_id") @db.VarChar(40)
  documentKey           String   @map("document_key") @db.VarChar(120)
  fileName              String   @map("file_name") @db.VarChar(255)
  contentType           String   @map("content_type") @db.VarChar(120)
  extension             String   @db.VarChar(20)
  size                  Int
  fileHash              String   @map("file_hash") @db.VarChar(128)
  version               Int
  supersedesId          String?  @map("supersedes_id") @db.VarChar(40)
  storageKey            String   @map("storage_key") @db.VarChar(255)
  storageProvider       String   @map("storage_provider") @db.VarChar(40)
  status                String   @db.VarChar(30)
  lineId                String?  @map("line_id") @db.VarChar(40)
  workOrderId           String?  @map("work_order_id") @db.VarChar(40)
  productCode           String?  @map("product_code") @db.VarChar(80)
  uploadedBy            String   @map("uploaded_by") @db.VarChar(80)
  uploadedAt            DateTime @map("uploaded_at")
  analysisStatus        String   @map("analysis_status") @db.VarChar(30)
  analysisDraft         Json?
  analysisConfirmedBy   String?  @map("analysis_confirmed_by") @db.VarChar(80)
  analysisConfirmedAt   DateTime? @map("analysis_confirmed_at")
  trace                 Json
  securityScanStatus    String   @default("not_scanned") @map("security_scan_status") @db.VarChar(20)
  securityScanProvider  String   @default("none") @map("security_scan_provider") @db.VarChar(80)
  securityScanMessage   String?  @map("security_scan_message") @db.VarChar(255)
  securityScannedAt     DateTime? @map("security_scanned_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, documentKey, version])
  @@map("document_records")
}

model DeviceEvent {
  id        String   @id @db.VarChar(160)
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  lineId    String?  @map("line_id") @db.VarChar(80)
  deviceId  String?  @map("device_id") @db.VarChar(80)
  eventType String   @map("event_type") @db.VarChar(40)
  eventTime DateTime @map("event_time")
  traceId   String?  @map("trace_id") @db.VarChar(120)
  quality   String?  @db.VarChar(40)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, deviceId, eventTime])
  @@index([tenantId, eventType, eventTime])
  @@map("device_events")
}

model CurrentState {
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  lineId    String   @map("line_id") @db.VarChar(80)
  deviceId  String   @map("device_id") @db.VarChar(80)
  status    String   @db.VarChar(40)
  eventTime DateTime @map("event_time")
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, lineId, deviceId])
  @@index([tenantId, status, eventTime])
  @@map("current_states")
}

model ConnectionEvent {
  id        String   @id @db.VarChar(160)
  tenantId  String   @map("tenant_id") @db.VarChar(40)
  gatewayId String?  @map("gateway_id") @db.VarChar(80)
  status    String   @db.VarChar(40)
  eventTime DateTime @map("event_time")
  details   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, eventTime])
  @@map("connection_events")
}

model StrategyRun {
  id           String   @id @db.VarChar(40)
  tenantId     String   @map("tenant_id") @db.VarChar(40)
  simulationId String   @map("simulation_id") @db.VarChar(80)
  snapshotAt   DateTime @map("snapshot_at")
  generatedAt  DateTime @map("generated_at")
  snapshot     Json
  risks        Json
  governance   Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  candidates StrategyCandidate[]

  @@unique([tenantId, simulationId])
  @@index([tenantId, snapshotAt])
  @@map("strategy_runs")
}

model StrategyCandidate {
  id                 String   @id @db.VarChar(40)
  strategyRunId      String   @map("strategy_run_id") @db.VarChar(40)
  action             String   @db.VarChar(60)
  risk               String   @db.VarChar(20)
  affectedOrders     Json     @map("affected_orders")
  fromLine           String?  @map("from_line") @db.VarChar(40)
  toLine             String?  @map("to_line") @db.VarChar(40)
  expectedFinishTime DateTime @map("expected_finish_time")
  expectedImpact     String   @map("expected_impact") @db.VarChar(500)
  reason             String   @db.VarChar(500)
  requiresApproval   Boolean  @default(true) @map("requires_approval")
  score              Int

  strategyRun StrategyRun @relation(fields: [strategyRunId], references: [id], onDelete: Cascade)

  @@index([strategyRunId, score])
  @@map("strategy_candidates")
}

model Product {
  id           String   @id @db.VarChar(40)
  tenantId     String   @map("tenant_id") @db.VarChar(40)
  code         String   @db.VarChar(40)
  name         String   @db.VarChar(120)
  unit         String?  @db.VarChar(20)
  description  String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("products")
}

model Operation {
  id              String   @id @db.VarChar(40)
  tenantId        String   @map("tenant_id") @db.VarChar(40)
  code            String   @db.VarChar(40)
  name            String   @db.VarChar(100)
  standardSeconds Int?     @map("standard_seconds")
  workstation     String?  @db.VarChar(80)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("operations")
}

model Bom {
  id           String   @id @db.VarChar(40)
  tenantId     String   @map("tenant_id") @db.VarChar(40)
  code         String   @db.VarChar(40)
  name         String   @db.VarChar(100)
  productCode  String   @map("product_code") @db.VarChar(40)
  version      String   @db.VarChar(20)
  items        Json
  operationCodes Json   @map("operation_codes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code, version])
  @@index([tenantId, productCode])
  @@map("boms")
}

model Routing {
  id             String   @id @db.VarChar(40)
  tenantId       String   @map("tenant_id") @db.VarChar(40)
  code           String   @db.VarChar(40)
  name           String   @db.VarChar(100)
  productCode    String   @map("product_code") @db.VarChar(40)
  version        String   @db.VarChar(20)
  operationCodes Json     @map("operation_codes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code, version])
  @@index([tenantId, productCode])
  @@map("routings")
}

model BatchInventory {
  id         String   @id @db.VarChar(40)
  tenantId   String   @map("tenant_id") @db.VarChar(40)
  materialCode String @map("material_code") @db.VarChar(40)
  batchNo    String   @map("batch_no") @db.VarChar(80)
  quantity   Decimal  @db.Decimal(18, 6)
  unit       String?  @db.VarChar(20)
  updatedAt  DateTime @updatedAt @map("updated_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, materialCode, batchNo])
  @@index([tenantId, materialCode])
  @@map("batch_inventories")
}
